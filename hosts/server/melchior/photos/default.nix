{ lib, ... }:

{
  # Immich photos, reachable only over Tailscale and the LAN: http://192.168.1.201:2283
  services.immich = {
    enable = true;
    host = "0.0.0.0"; # the firewall only lets tailscale0 and eno1 in
    port = 2283;
    mediaLocation = "/mnt/storage/immich"; # also holds Immich's nightly database dumps (backups/)
  };

  # The module's tmpfiles rule only fixes permissions, it doesn't create the directory
  systemd.tmpfiles.rules = [ "d /mnt/storage/immich 0700 immich immich - -" ];

  # Daily snapshot to the external disk. The job fails (and alerts on Discord) if the disk isn't mounted
  services.borgbackup.jobs.immich = {
    paths = [ "/mnt/storage/immich" ]; # includes Immich's 02:00 database dumps in backups/
    exclude = [
      # Regenerated by Immich from the originals
      "/mnt/storage/immich/thumbs"
      "/mnt/storage/immich/encoded-video"
    ];
    repo = "/mnt/backups/immich";
    # Don't let tmpfiles create the repo on the root fs when the disk is missing.
    # The job's sandbox needs the directory to exist, create it once on the disk: `sudo mkdir /mnt/backups/immich`
    removableDevice = true;
    encryption.mode = "none"; # same physical security as the unencrypted source disk
    compression = "auto,zstd";
    startAt = "02:30"; # after the database dump, before nightly gc/upgrade/reboot
    persistentTimer = true;
    prune.keep = { daily = 7; weekly = 4; monthly = 6; };
  };

  # Immich only needs the unix socket, keep postgres off the network
  services.postgresql.settings.listen_addresses = lib.mkForce "";

  networking.firewall.interfaces.tailscale0.allowedTCPPorts = [ 2283 ];
  networking.firewall.interfaces.eno1.allowedTCPPorts = [ 2283 ]; # LAN
}
